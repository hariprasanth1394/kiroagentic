  "resolutionLogic": {
    "description": "Reference lookup for a human/CI operator (NOT an AI skill) deciding which EXTERNAL suite covers a feature area. The v4 AI pipeline does not execute these; it runs its own unified regression-suite via the execution skill's domain/full modes.",
    "steps": [
      "1. If a suite name is given directly → use that suite from suites{}",
      "2. If a feature area is given → look up impactMap[area].affectedSuites",
      "3. If a JIRA story key is given → check suites{}.stories for match",
      "4. If 'Run Regression' with no args → use all suites with lastResult != null OR ask",
      "5. If nothing matches → 'No external suite registered for this area'"
    ]
  }
